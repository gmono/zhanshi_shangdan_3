    "ionic:build": "pnpm build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:ios": "tauri ios dev",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:ios": "tauri ios build",
    "relay": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run && node --test tests/relay.test.mjs",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "tiles:serve": "node scripts/zoomify-http.mjs"
  },
