    "ionicons": "^8.0.13",
    "lucide-react": "^0.468.0",
    "ol": "^10.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
